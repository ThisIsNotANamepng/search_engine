# Copy to /etc/stultus/proxy.env (root:root, mode 600).
# PROXY_PASSWORD must match SCRAPER_PROXY_PASSWORD on the workers and the
# upstream proxy's PROXY_PASSWORD (it is forwarded on /fetch chain hops).
# deploy/db01/connect_vps_proxy.sh writes this file for you; see docs/docs/proxy.md.
PROXY_ADDR=:8888
PROXY_UPSTREAM=https://UPSTREAM-HOST:8443
PROXY_PASSWORD=CHANGE_ME
# The VPS's self-signed certificate, the only one this proxy trusts (it dials nothing but the VPS)
SSL_CERT_FILE=/etc/stultus/vps-proxy.crt
# DEBUG=1
