# Copy to /etc/stultus/head.env (root:root, mode 600).
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/DBNAME
# Required by frontend/app.py from commit 755eae3 on: HTTP basic auth password for
# /dashboard, /nodes/ and /agent/. Every worker's /etc/stultus/crawler.env needs the
# same value as ADMIN_PASSWORD, or their heartbeats get 401.
ADMIN_PASSWORD=CHANGE_ME
