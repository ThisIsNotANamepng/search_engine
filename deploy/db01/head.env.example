# Copy to /etc/stultus/head.env (root:root, mode 600).
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/DBNAME
# The crawlers' proxy password (same as SCRAPER_PROXY_PASSWORD on the workers and PROXY_PASSWORD in
# /etc/stultus/proxy.env). The dashboard uses it to fetch a test page through the proxy chain, so
# "Proxy" goes red when crawlers can't fetch, not only when db01:8888 stops listening.
SCRAPER_PROXY_PASSWORD=CHANGE_ME
